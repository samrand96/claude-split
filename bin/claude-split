#!/bin/bash
set -euo pipefail

APP_NAME="Claude"
APP_BUNDLE="${CLAUDE_SPLIT_APP_BUNDLE:-/Applications/Claude.app}"
DATA_ROOT="${CLAUDE_SPLIT_HOME:-$HOME/.local/share/claude-split}"
PROFILE_ROOT="$DATA_ROOT/profiles"
DESKTOP_ROOT="$HOME/Library/Application Support/Claude-Split"
ACTIVE_FILE="$DATA_ROOT/active-profile"
LOG_ROOT="$DATA_ROOT/logs"

mkdir -p "$PROFILE_ROOT" "$DESKTOP_ROOT" "$LOG_ROOT"

usage() {
  cat <<'USAGE'
claude-split — multiple Claude accounts on one Mac

Usage:
  clp add <profile>                   Create an isolated profile
  clp list                            List profiles
  clp use <profile>                   Save the active profile
  clp current                         Show the active profile

  clp auth [profile]                  Show Claude Code auth for that profile
  clp login [profile]                 Log that profile into Claude Code
  clp logout [profile]                Log that profile out of Claude Code

  clp code [profile] [-- args...]     Launch Claude Code for a profile
  clp desktop [profile]               Launch Claude Desktop for a profile
  clp both [profile] [-- args...]     Launch Desktop, then Claude Code

  clp doctor                          Check installation and conflicting env vars
  clp path <profile>                  Show profile storage paths
  clp purge <profile>                 Permanently delete profile data
  clp help                            Show this help

The special profile "default" uses your existing Claude login and files.
Named profiles isolate both Desktop state and Claude Code auth/config.
USAGE
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

valid_profile() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

profile_dir() {
  printf '%s/%s/code\n' "$PROFILE_ROOT" "$1"
}

desktop_dir() {
  printf '%s/%s\n' "$DESKTOP_ROOT" "$1"
}

profile_exists() {
  [ "$1" = "default" ] || [ -d "$PROFILE_ROOT/$1" ]
}

active_profile() {
  if [ -f "$ACTIVE_FILE" ]; then
    cat "$ACTIVE_FILE"
  else
    printf 'default\n'
  fi
}

resolve_profile() {
  local requested="${1:-}"
  if [ -z "$requested" ]; then
    requested="$(active_profile)"
  fi
  valid_profile "$requested" || die "invalid profile name: $requested"
  profile_exists "$requested" || die "profile '$requested' does not exist; run: clp add $requested"
  printf '%s\n' "$requested"
}

find_claude_cli() {
  local candidate=""
  if [ -n "${CLAUDE_SPLIT_CLAUDE_BIN:-}" ]; then
    candidate="$CLAUDE_SPLIT_CLAUDE_BIN"
  else
    candidate="$(command -v claude 2>/dev/null || true)"
  fi
  [ -n "$candidate" ] || die "Claude Code CLI not found on PATH"
  printf '%s\n' "$candidate"
}

# Run a command with stale Claude/provider/proxy overrides removed. This is
# deliberate: profile identity must come from the selected Claude profile, not
# from ANTHROPIC_API_KEY/AUTH_TOKEN, an old local gateway, Vertex, or a stale
# HTTP proxy exported for another development tool.
clean_env() {
  /usr/bin/env \
    -u ANTHROPIC_API_KEY \
    -u ANTHROPIC_AUTH_TOKEN \
    -u ANTHROPIC_BASE_URL \
    -u ANTHROPIC_CUSTOM_HEADERS \
    -u CLAUDE_CODE_USE_VERTEX \
    -u CLAUDE_CODE_USE_BEDROCK \
    -u CLAUDE_CODE_USE_FOUNDRY \
    -u GOOGLE_APPLICATION_CREDENTIALS \
    -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u NO_PROXY \
    -u http_proxy -u https_proxy -u all_proxy -u no_proxy \
    -u NODE_OPTIONS \
    "$@"
}

run_profile_cli() {
  local profile="$1"
  shift

  local bin
  bin="$(find_claude_cli)"

  if [ "$profile" = "default" ]; then
    clean_env "$bin" "$@"
    return
  fi

  local cfg
  cfg="$(profile_dir "$profile")"
  mkdir -p "$cfg"

  clean_env \
    CLAUDE_CONFIG_DIR="$cfg" \
    CLAUDE_SECURESTORAGE_CONFIG_DIR="$cfg" \
    "$bin" "$@"
}

cmd_add() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: clp add <profile>"
  [ "$name" != "default" ] || die "'default' is reserved for your existing Claude profile"
  valid_profile "$name" || die "profile names may contain only letters, numbers, dot, underscore, and dash"
  [ ! -d "$PROFILE_ROOT/$name" ] || die "profile '$name' already exists"

  mkdir -p "$(profile_dir "$name")" "$(desktop_dir "$name")"
  printf 'created profile: %s\n\n' "$name"
  printf '1. Login CLI identity:   clp login %s\n' "$name"
  printf '2. Verify identity:      clp auth %s\n' "$name"
  printf '3. Open Desktop:         clp desktop %s\n' "$name"
  printf '4. Open CLI:             clp code %s\n' "$name"
}

cmd_list() {
  local active
  active="$(active_profile)"
  if [ "$active" = "default" ]; then printf '* '; else printf '  '; fi
  printf 'default\n'

  local dir name
  for dir in "$PROFILE_ROOT"/*; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    if [ "$name" = "$active" ]; then printf '* '; else printf '  '; fi
    printf '%s\n' "$name"
  done
}

cmd_use() {
  local name
  name="$(resolve_profile "${1:-}")"
  printf '%s\n' "$name" > "$ACTIVE_FILE"
  printf 'active profile: %s\n' "$name"
}

cmd_current() {
  printf '%s\n' "$(active_profile)"
}

cmd_auth() {
  local profile
  profile="$(resolve_profile "${1:-}")"
  printf 'Profile: %s\n' "$profile"
  if [ "$profile" != "default" ]; then
    printf 'Config:  %s\n' "$(profile_dir "$profile")"
  fi
  printf '\n'
  run_profile_cli "$profile" auth status --text || true
}

cmd_login() {
  local profile
  profile="$(resolve_profile "${1:-}")"
  printf 'Logging Claude Code profile "%s" in.\n' "$profile"
  printf 'This login is stored in that profile\x27s own credential slot.\n\n'
  run_profile_cli "$profile" auth login
}

cmd_logout() {
  local profile
  profile="$(resolve_profile "${1:-}")"
  printf 'Logging Claude Code profile "%s" out.\n' "$profile"
  run_profile_cli "$profile" auth logout
}

cmd_code() {
  local maybe_profile="${1:-}"
  local profile

  if [ -n "$maybe_profile" ] && [ "$maybe_profile" != "--" ] && profile_exists "$maybe_profile"; then
    profile="$maybe_profile"
    shift
  else
    profile="$(active_profile)"
  fi

  if [ "${1:-}" = "--" ]; then shift; fi
  profile="$(resolve_profile "$profile")"

  printf 'Claude Code profile: %s\n' "$profile" >&2
  if [ "$profile" != "default" ]; then
    printf 'Claude config:       %s\n' "$(profile_dir "$profile")" >&2
  fi
  printf '\n' >&2

  run_profile_cli "$profile" "$@"
}

launch_desktop_default() {
  [ -d "$APP_BUNDLE" ] || die "Claude Desktop not found at $APP_BUNDLE"

  # Use LaunchServices for the stock instance, but strip the exact environment
  # variables that previously caused CLI/Desktop auth and proxy confusion.
  clean_env /usr/bin/open -a "$APP_BUNDLE"
  printf 'opened Claude Desktop profile: default\n'
  printf 'Desktop account: normal existing Claude Desktop login\n'
  printf 'Code account:    normal existing Claude Code login\n'
}

launch_desktop_named() {
  local profile="$1"
  [ -d "$APP_BUNDLE" ] || die "Claude Desktop not found at $APP_BUNDLE"

  local data cfg log
  data="$(desktop_dir "$profile")"
  cfg="$(profile_dir "$profile")"
  log="$LOG_ROOT/desktop-$profile.log"
  mkdir -p "$data" "$cfg"

  printf 'Launching Claude Desktop profile: %s\n' "$profile"
  printf 'Desktop data: %s\n' "$data"
  printf 'Code config:  %s\n' "$cfg"
  printf '\n'

  # IMPORTANT:
  # --user-data-dir / CLAUDE_USER_DATA_DIR isolate Desktop chat cookies/login.
  # CLAUDE_CONFIG_DIR + secure-storage dir make the Desktop Code tab inherit the
  # SAME Claude Code account as `clp code <profile>`.
  # `open -n` asks LaunchServices for a separate application instance, while
  # --env injects the profile environment into that specific instance.
  # The surrounding clean_env prevents old shell API keys/proxies from winning.
  if [ "$(uname -m)" = "arm64" ]; then
    clean_env /usr/bin/open -n --arch arm64 -a "$APP_BUNDLE" \
      --env "CLAUDE_USER_DATA_DIR=$data" \
      --env "CLAUDE_CONFIG_DIR=$cfg" \
      --env "CLAUDE_SECURESTORAGE_CONFIG_DIR=$cfg" \
      --stderr "$log" \
      --stdout "$log" \
      --args "--user-data-dir=$data"
  else
    clean_env /usr/bin/open -n -a "$APP_BUNDLE" \
      --env "CLAUDE_USER_DATA_DIR=$data" \
      --env "CLAUDE_CONFIG_DIR=$cfg" \
      --env "CLAUDE_SECURESTORAGE_CONFIG_DIR=$cfg" \
      --stderr "$log" \
      --stdout "$log" \
      --args "--user-data-dir=$data"
  fi

  printf 'launched profile: %s\n' "$profile"
  printf 'log: %s\n' "$log"
  printf '\nIf this is the first Desktop launch, sign the Desktop window into the SAME account shown by:\n'
  printf '  clp auth %s\n' "$profile"
}

cmd_desktop() {
  local profile
  profile="$(resolve_profile "${1:-}")"

  if [ "$profile" = "default" ]; then
    launch_desktop_default
  else
    launch_desktop_named "$profile"
  fi
}

cmd_both() {
  local maybe_profile="${1:-}"
  local profile

  if [ -n "$maybe_profile" ] && [ "$maybe_profile" != "--" ] && profile_exists "$maybe_profile"; then
    profile="$maybe_profile"
    shift
  else
    profile="$(active_profile)"
  fi
  if [ "${1:-}" = "--" ]; then shift; fi

  profile="$(resolve_profile "$profile")"
  cmd_desktop "$profile"
  sleep 1
  cmd_code "$profile" -- "$@"
}

cmd_path() {
  local profile
  profile="$(resolve_profile "${1:-}")"
  if [ "$profile" = "default" ]; then
    printf 'CLI config:      %s/.claude\n' "$HOME"
    printf 'Desktop data:    %s/Library/Application Support/Claude\n' "$HOME"
    printf 'Credential slot: default Claude Code Keychain entry\n'
  else
    printf 'CLI config:      %s\n' "$(profile_dir "$profile")"
    printf 'Desktop data:    %s\n' "$(desktop_dir "$profile")"
    printf 'Credential slot: derived from the profile config directory\n'
  fi
}

cmd_purge() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: clp purge <profile>"
  [ "$name" != "default" ] || die "refusing to purge the default Claude profile"
  profile_exists "$name" || die "profile '$name' does not exist"

  printf 'This permanently deletes local profile data for "%s". Type the profile name to confirm: ' "$name"
  local answer
  IFS= read -r answer
  [ "$answer" = "$name" ] || die "confirmation did not match; nothing deleted"

  rm -rf "$PROFILE_ROOT/$name" "$(desktop_dir "$name")"
  if [ "$(active_profile)" = "$name" ]; then
    printf 'default\n' > "$ACTIVE_FILE"
  fi
  printf 'purged profile: %s\n' "$name"
  printf 'A profile-specific Claude Code credential may remain in macOS Keychain.\n'
}

cmd_doctor() {
  local failed=0
  printf 'Claude Split doctor\n\n'

  if [ "$(uname -s)" = "Darwin" ]; then
    printf '[ok] macOS detected\n'
  else
    printf '[fail] this project supports macOS only\n'
    failed=1
  fi

  if [ -d "$APP_BUNDLE" ]; then
    printf '[ok] Claude Desktop: %s\n' "$APP_BUNDLE"
  else
    printf '[warn] Claude Desktop not found at %s\n' "$APP_BUNDLE"
  fi

  local bin
  bin="$(command -v claude 2>/dev/null || true)"
  if [ -n "$bin" ]; then
    printf '[ok] Claude Code: %s\n' "$bin"
  else
    printf '[warn] Claude Code CLI not found on PATH\n'
  fi

  local had_conflict=0
  local v
  for v in \
    ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
    CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_FOUNDRY \
    GOOGLE_APPLICATION_CREDENTIALS \
    HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy NODE_OPTIONS; do
    if [ -n "${!v:-}" ]; then
      printf '[warn] %s is set in the current shell\n' "$v"
      had_conflict=1
    fi
  done
  if [ "$had_conflict" -eq 0 ]; then
    printf '[ok] no known Claude/provider/proxy overrides detected\n'
  else
    printf '       clp strips these overrides when it launches Claude.\n'
  fi

  if /usr/bin/open --help 2>&1 | grep -q -- '--env'; then
    printf '[ok] macOS open supports per-instance --env injection\n'
  else
    printf '[warn] this macOS open command does not advertise --env; named Desktop profiles may not launch correctly\n'
  fi

  printf '[ok] profile root: %s\n' "$PROFILE_ROOT"
  printf '[ok] desktop root: %s\n' "$DESKTOP_ROOT"
  printf '\nactive profile: %s\n' "$(active_profile)"
  return "$failed"
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    add) cmd_add "$@" ;;
    list|ls) cmd_list ;;
    use) cmd_use "$@" ;;
    current|status) cmd_current ;;
    auth|who) cmd_auth "$@" ;;
    login) cmd_login "$@" ;;
    logout) cmd_logout "$@" ;;
    code|cli) cmd_code "$@" ;;
    desktop|app) cmd_desktop "$@" ;;
    both|open) cmd_both "$@" ;;
    doctor) cmd_doctor ;;
    path) cmd_path "$@" ;;
    purge) cmd_purge "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $command (try: clp help)" ;;
  esac
}

main "$@"
